digraph G {
  rankdir=LR; fontname="Helvetica"; compound=true; nodesep=0.35; ranksep=0.55; pad=0.3; bgcolor="white";
  node [fontname="Helvetica", fontsize=11, shape=circle, width=0.42, fixedsize=false, style=filled, fillcolor="#f8fafc", color="#475569"];
  edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
  labelloc=t; labeljust=l;
  label=<<TABLE BORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20"><B>GoBench etcd #6857</B></FONT>  <FONT POINT-SIZE="13" COLOR="#475569">Blocking / Communication Deadlock / Channel</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"><B>Issue:</B> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">After Stop() makes run() return (it closes n.done), a later Status() call sends its request on n.status.<BR ALIGN="LEFT"/>Nobody receives it any more, so that goroutine leaks.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>IPs detected:</B></TD><TD BGCOLOR="#1b7f3b"><FONT COLOR="white"><B> IP-1 </B> Send/Receive </FONT></TD><TD WIDTH="4"></TD><TD BGCOLOR="#b45309"><FONT COLOR="white"><B> IP-3 </B> Alternative </FONT></TD><TD WIDTH="4"></TD><TD BGCOLOR="#7c3aed"><FONT COLOR="white"><B> IP-4 </B> Exchange </FONT></TD><TD WIDTH="4"></TD><TD BGCOLOR="#be123c"><FONT COLOR="white"><B> IP-8 </B> Racing receive </FONT></TD><TD WIDTH="4"></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"><B>What the CFSM shows:</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">• c (reply, run): a send exists but no goroutine ever receives from it<BR ALIGN="LEFT"/>• c (reply, Status): a receive exists but no goroutine ever sends on it<BR ALIGN="LEFT"/>• a channel is passed as a value: dingo-hunter loses the alias, so a reply channel can show up as two channels (the red<BR ALIGN="LEFT"/>⚠ marks on them are a tool artefact)<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD> </TD></TR></TABLE>>;
  subgraph cluster_g5 { label=<<B>machine 5: Status</B>>; labeljust=l; style="rounded,filled"; fillcolor="#f1f5f9"; color="#94a3b8"; fontsize=12;
    g5_q50 [label="50" penwidth=2.4];
    g5_q51 [label="51"];
    g5_q52 [label="52" shape=doublecircle];
    g5_start [shape=point, width=0.08, style=invis, label=""];
    g5_start -> g5_q50 [arrowsize=0.9, color="#475569"];
    g5_q50 -> g5_q51 [label=<n.status ! chan main.Status<BR/><FONT COLOR="#1b7f3b" POINT-SIZE="9"><B>[IP-1] </B></FONT>>, color="#1d4ed8", fontcolor="#1d4ed8", style=solid, penwidth=1.2];
    g5_q51 -> g5_q52 [label=<c (reply, Status) ? main.Status<FONT COLOR="#dc2626">  ⚠ no sender</FONT>>, color="#dc2626", fontcolor="#dc2626", style=solid, penwidth=2.2];
  }
  subgraph cluster_g6 { label=<<B>machine 6: Stop</B>>; labeljust=l; style="rounded,filled"; fillcolor="#f1f5f9"; color="#94a3b8"; fontsize=12;
    g6_q60 [label="60" penwidth=2.4 fillcolor="#b4530922" color="#b45309" penwidth=2.4 xlabel=<<FONT COLOR="#b45309" POINT-SIZE="10"><B>IP-3</B></FONT>>];
    g6_q61 [label="61"];
    g6_q63 [label="63" shape=doublecircle];
    g6_q62 [label="62" shape=doublecircle];
    g6_start [shape=point, width=0.08, style=invis, label=""];
    g6_start -> g6_q60 [arrowsize=0.9, color="#475569"];
    g6_q60 -> g6_q61 [label=<n.stop ! struct{}<BR/><FONT COLOR="#1b7f3b" POINT-SIZE="9"><B>[IP-1] </B></FONT><FONT COLOR="#b45309" POINT-SIZE="9"><B>[IP-3] </B></FONT><FONT COLOR="#7c3aed" POINT-SIZE="9"><B>[IP-4] </B></FONT>>, color="#1d4ed8", fontcolor="#1d4ed8", style=solid, penwidth=1.2];
    g6_q60 -> g6_q63 [label=<n.done ? struct{}<BR/><FONT COLOR="#b45309" POINT-SIZE="9"><B>[IP-3] </B></FONT><FONT COLOR="#7c3aed" POINT-SIZE="9"><B>[IP-4] </B></FONT>>, color="#15803d", fontcolor="#15803d", style=solid, penwidth=1.2];
    g6_q61 -> g6_q62 [label=<n.done ? struct{}<BR/><FONT COLOR="#7c3aed" POINT-SIZE="9"><B>[IP-4] </B></FONT>>, color="#15803d", fontcolor="#15803d", style=solid, penwidth=1.2];
  }
  subgraph cluster_g7 { label=<<B>machine 7: run</B>>; labeljust=l; style="rounded,filled"; fillcolor="#f1f5f9"; color="#94a3b8"; fontsize=12;
    g7_q70 [label="70" penwidth=2.4 fillcolor="#be123c22" color="#be123c" penwidth=2.4 xlabel=<<FONT COLOR="#be123c" POINT-SIZE="10"><B>IP-8</B></FONT>>];
    g7_q71 [label="71"];
    g7_q73 [label="73"];
    g7_q72 [label="72" shape=doublecircle];
    g7_q74 [label="74" shape=doublecircle];
    g7_start [shape=point, width=0.08, style=invis, label=""];
    g7_start -> g7_q70 [arrowsize=0.9, color="#475569"];
    g7_q70 -> g7_q71 [label=<n.status ? chan main.Status<BR/><FONT COLOR="#1b7f3b" POINT-SIZE="9"><B>[IP-1] </B></FONT><FONT COLOR="#be123c" POINT-SIZE="9"><B>[IP-8] </B></FONT>>, color="#15803d", fontcolor="#15803d", style=solid, penwidth=1.2];
    g7_q70 -> g7_q73 [label=<n.stop ? struct{}<BR/><FONT COLOR="#1b7f3b" POINT-SIZE="9"><B>[IP-1] </B></FONT><FONT COLOR="#7c3aed" POINT-SIZE="9"><B>[IP-4] </B></FONT><FONT COLOR="#be123c" POINT-SIZE="9"><B>[IP-8] </B></FONT>>, color="#15803d", fontcolor="#15803d", style=solid, penwidth=1.2];
    g7_q71 -> g7_q72 [label=<c (reply, run) ! main.Status<FONT COLOR="#dc2626">  ⚠ no receiver</FONT>>, color="#dc2626", fontcolor="#dc2626", style=solid, penwidth=2.2];
    g7_q73 -> g7_q74 [label=<close(n.done)<BR/><FONT COLOR="#7c3aed" POINT-SIZE="9"><B>[IP-4] </B></FONT>>, color="#b91c1c", fontcolor="#b91c1c", style=dashed, penwidth=1.2];
  }
  legend [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD COLSPAN="5" BGCOLOR="#e2e8f0"><B>Channels in this system</B> (channel relay machines 0–4 omitted from the drawing)</TD></TR><TR><TD><B>name</B></TD><TD><B>allocated in</B></TD><TD><B>sent by</B></TD><TD><B>received by</B></TD><TD><B>closed by</B></TD></TR><TR><TD ALIGN="LEFT">n.status</TD><TD ALIGN="LEFT">main.NewNode.t2</TD><TD>5</TD><TD>7</TD><TD>–</TD></TR><TR><TD ALIGN="LEFT">n.stop</TD><TD ALIGN="LEFT">main.NewNode.t4</TD><TD>6</TD><TD>7</TD><TD>–</TD></TR><TR><TD ALIGN="LEFT">n.done</TD><TD ALIGN="LEFT">main.NewNode.t6</TD><TD>–</TD><TD>6</TD><TD>7</TD></TR><TR><TD ALIGN="LEFT">c (reply, run)</TD><TD ALIGN="LEFT">(*main.node).run.t7</TD><TD>7</TD><TD>–</TD><TD>–</TD></TR><TR><TD ALIGN="LEFT">c (reply, Status)</TD><TD ALIGN="LEFT">(*main.node).Status.t0</TD><TD>–</TD><TD>5</TD><TD>–</TD></TR><TR><TD COLSPAN="5" ALIGN="LEFT"><FONT POINT-SIZE="10">Edge label  <FONT COLOR="#1d4ed8">ch ! msg</FONT> = send,  <FONT COLOR="#15803d">ch ? msg</FONT> = receive,  <FONT COLOR="#b91c1c">close(ch)</FONT> = STOP message.  Bold circle = start state, double circle = end state, numbers in machines = machine ids.</FONT></TD></TR></TABLE>>];
}