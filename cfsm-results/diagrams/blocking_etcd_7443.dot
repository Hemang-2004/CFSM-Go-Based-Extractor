digraph G {
  rankdir=LR; fontname="Helvetica"; compound=true; nodesep=0.35; ranksep=0.55; pad=0.3; bgcolor="white";
  node [fontname="Helvetica", fontsize=11, shape=circle, width=0.42, fixedsize=false, style=filled, fillcolor="#f8fafc", color="#475569"];
  edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
  labelloc=t; labeljust=l;
  label=<<TABLE BORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20"><B>GoBench etcd #7443</B></FONT>  <FONT POINT-SIZE="13" COLOR="#475569">Blocking / Mixed Deadlock / Channel &amp; Lock</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"><B>Issue:</B> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">Line 161 holds mutex at 158 but try to send messages to `notifyCh` at 161. `Close()` goroutine blocked at<BR ALIGN="LEFT"/>line 172 for acquiring the same mutex.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>IPs detected:</B></TD><TD BGCOLOR="#6b7280"><FONT COLOR="white"> no interface pattern detected </FONT></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"><B>What the CFSM shows:</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">• ch0: a send exists but no goroutine ever receives from it<BR ALIGN="LEFT"/>• ch2: a receive exists but no goroutine ever sends on it<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">Source uses buffered channel(s), capacity 1; dingo-hunter ignores capacity (models them as unbuffered).</FONT></TD></TR><TR><TD> </TD></TR></TABLE>>;
  subgraph cluster_g3 { label=<<B>machine 3: main</B>>; labeljust=l; style="rounded,filled"; fillcolor="#f1f5f9"; color="#94a3b8"; fontsize=12;
    g3_q30 [label="30" penwidth=2.4];
    g3_q31 [label="31"];
    g3_q32 [label="32" shape=doublecircle];
    g3_start [shape=point, width=0.08, style=invis, label=""];
    g3_start -> g3_q30 [arrowsize=0.9, color="#475569"];
    g3_q30 -> g3_q31 [label=<ch0 ! []main.Address<FONT COLOR="#dc2626">  ⚠ no receiver</FONT>>, color="#dc2626", fontcolor="#dc2626", style=solid, penwidth=2.2];
    g3_q31 -> g3_q32 [label=<ch1 ? struct{}>, color="#15803d", fontcolor="#15803d", style=solid, penwidth=1.2];
  }
  subgraph cluster_g4 { label=<<B>machine 4: lbWatcher</B>>; labeljust=l; style="rounded,filled"; fillcolor="#f1f5f9"; color="#94a3b8"; fontsize=12;
    g4_q40 [label="40" penwidth=2.4];
    g4_q41 [label="41" shape=doublecircle];
    g4_start [shape=point, width=0.08, style=invis, label=""];
    g4_start -> g4_q40 [arrowsize=0.9, color="#475569"];
    g4_q40 -> g4_q41 [label=<ch2 ? []main.Address<FONT COLOR="#dc2626">  ⚠ no sender</FONT>>, color="#dc2626", fontcolor="#dc2626", style=solid, penwidth=2.2];
  }
  subgraph cluster_g5 { label=<<B>machine 5: anonymous goroutine (t11)</B>>; labeljust=l; style="rounded,filled"; fillcolor="#f1f5f9"; color="#94a3b8"; fontsize=12;
    g5_q50 [label="50" penwidth=2.4];
    g5_q51 [label="51"];
    g5_q52 [label="52" shape=doublecircle];
    g5_start [shape=point, width=0.08, style=invis, label=""];
    g5_start -> g5_q50 [arrowsize=0.9, color="#475569"];
    g5_q50 -> g5_q51 [label=<close(ch0)>, color="#b91c1c", fontcolor="#b91c1c", style=dashed, penwidth=1.2];
    g5_q51 -> g5_q52 [label=<close(ch1)>, color="#b91c1c", fontcolor="#b91c1c", style=dashed, penwidth=1.2];
  }
  legend [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD COLSPAN="5" BGCOLOR="#e2e8f0"><B>Channels in this system</B> (channel relay machines 0–2 omitted from the drawing)</TD></TR><TR><TD><B>name</B></TD><TD><B>allocated in</B></TD><TD><B>sent by</B></TD><TD><B>received by</B></TD><TD><B>closed by</B></TD></TR><TR><TD ALIGN="LEFT">ch0</TD><TD ALIGN="LEFT">main.newSimpleBalancer.t0</TD><TD>3</TD><TD>–</TD><TD>5</TD></TR><TR><TD ALIGN="LEFT">ch1</TD><TD ALIGN="LEFT">main.main.t10</TD><TD>–</TD><TD>3</TD><TD>5</TD></TR><TR><TD ALIGN="LEFT">ch2</TD><TD ALIGN="LEFT">(*main.ClientConn).lbWatcher.t3</TD><TD>–</TD><TD>4</TD><TD>–</TD></TR><TR><TD COLSPAN="5" ALIGN="LEFT"><FONT POINT-SIZE="10">Edge label  <FONT COLOR="#1d4ed8">ch ! msg</FONT> = send,  <FONT COLOR="#15803d">ch ? msg</FONT> = receive,  <FONT COLOR="#b91c1c">close(ch)</FONT> = STOP message.  Bold circle = start state, double circle = end state, numbers in machines = machine ids.</FONT></TD></TR></TABLE>>];
}