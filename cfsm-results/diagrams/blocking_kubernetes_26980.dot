digraph G {
  rankdir=LR; fontname="Helvetica"; compound=true; nodesep=0.35; ranksep=0.55; pad=0.3; bgcolor="white";
  node [fontname="Helvetica", fontsize=11, shape=circle, width=0.42, fixedsize=false, style=filled, fillcolor="#f8fafc", color="#475569"];
  edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
  labelloc=t; labeljust=l;
  label=<<TABLE BORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20"><B>GoBench kubernetes #26980</B></FONT>  <FONT POINT-SIZE="13" COLOR="#475569">Blocking / Mixed Deadlock / Channel &amp; Lock</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"><B>Issue:</B> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">A goroutine holds a mutex at line 24 and blocked at line 35. Another goroutine blocked at line 58 by<BR ALIGN="LEFT"/>acquiring the same mutex.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>IPs detected:</B></TD><TD BGCOLOR="#b45309"><FONT COLOR="white"><B> IP-3 </B> Alternative </FONT></TD><TD WIDTH="4"></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"><B>What the CFSM shows:</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">• no unmatched send/receive: every channel has both ends. Any bug lies in ordering (needs the synthesis step), or in the<BR ALIGN="LEFT"/>lock / WaitGroup / Cond part, which the CFSM does not model<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD> </TD></TR></TABLE>>;
  subgraph cluster_g2 { label=<<B>machine 2: main</B>>; labeljust=l; style="rounded,filled"; fillcolor="#f1f5f9"; color="#94a3b8"; fontsize=12;
    g2_q20 [label="20" penwidth=2.4];
    g2_q21 [label="21"];
    g2_q22 [label="22" shape=doublecircle];
    g2_start [shape=point, width=0.08, style=invis, label=""];
    g2_start -> g2_q20 [arrowsize=0.9, color="#475569"];
    g2_q20 -> g2_q21 [label=<ch1 ? struct{}>, color="#15803d", fontcolor="#15803d", style=solid, penwidth=1.2];
    g2_q21 -> g2_q22 [label=<close(ch0)>, color="#b91c1c", fontcolor="#b91c1c", style=dashed, penwidth=1.2];
  }
  subgraph cluster_g3 { label=<<B>machine 3: pop</B>>; labeljust=l; style="rounded,filled"; fillcolor="#f1f5f9"; color="#94a3b8"; fontsize=12;
    g3_q30 [label="30" penwidth=2.4 fillcolor="#b4530922" color="#b45309" penwidth=2.4 xlabel=<<FONT COLOR="#b45309" POINT-SIZE="10"><B>IP-3</B></FONT>>];
    g3_q31 [label="31" shape=doublecircle];
    g3_q32 [label="32" shape=doublecircle];
    g3_start [shape=point, width=0.08, style=invis, label=""];
    g3_start -> g3_q30 [arrowsize=0.9, color="#475569"];
    g3_q30 -> g3_q31 [label=<ch0 ? struct{}<BR/><FONT COLOR="#b45309" POINT-SIZE="9"><B>[IP-3] </B></FONT>>, color="#15803d", fontcolor="#15803d", style=solid, penwidth=1.2];
    g3_q30 -> g3_q32 [label=<ch0 ? struct{}<BR/><FONT COLOR="#b45309" POINT-SIZE="9"><B>[IP-3] </B></FONT>>, color="#15803d", fontcolor="#15803d", style=solid, penwidth=1.2];
  }
  subgraph cluster_g4 { label=<<B>machine 4: anonymous goroutine (t10)</B>>; labeljust=l; style="rounded,filled"; fillcolor="#f1f5f9"; color="#94a3b8"; fontsize=12;
    g4_q40 [label="40" penwidth=2.4];
    g4_q41 [label="41" shape=doublecircle];
    g4_start [shape=point, width=0.08, style=invis, label=""];
    g4_start -> g4_q40 [arrowsize=0.9, color="#475569"];
    g4_q40 -> g4_q41 [label=<close(ch1)>, color="#b91c1c", fontcolor="#b91c1c", style=dashed, penwidth=1.2];
  }
  legend [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD COLSPAN="5" BGCOLOR="#e2e8f0"><B>Channels in this system</B> (channel relay machines 0–1 omitted from the drawing)</TD></TR><TR><TD><B>name</B></TD><TD><B>allocated in</B></TD><TD><B>sent by</B></TD><TD><B>received by</B></TD><TD><B>closed by</B></TD></TR><TR><TD ALIGN="LEFT">ch0</TD><TD ALIGN="LEFT">main.main.t2</TD><TD>–</TD><TD>3</TD><TD>2</TD></TR><TR><TD ALIGN="LEFT">ch1</TD><TD ALIGN="LEFT">main.main.t9</TD><TD>–</TD><TD>2</TD><TD>4</TD></TR><TR><TD COLSPAN="5" ALIGN="LEFT"><FONT POINT-SIZE="10">Edge label  <FONT COLOR="#1d4ed8">ch ! msg</FONT> = send,  <FONT COLOR="#15803d">ch ? msg</FONT> = receive,  <FONT COLOR="#b91c1c">close(ch)</FONT> = STOP message.  Bold circle = start state, double circle = end state, numbers in machines = machine ids.</FONT></TD></TR></TABLE>>];
}