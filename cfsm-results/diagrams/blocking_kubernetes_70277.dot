digraph G {
  rankdir=LR; fontname="Helvetica"; compound=true; nodesep=0.35; ranksep=0.55; pad=0.3; bgcolor="white";
  node [fontname="Helvetica", fontsize=11, shape=circle, width=0.42, fixedsize=false, style=filled, fillcolor="#f8fafc", color="#475569"];
  edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
  labelloc=t; labeljust=l;
  label=<<TABLE BORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20"><B>GoBench kubernetes #70277</B></FONT>  <FONT POINT-SIZE="13" COLOR="#475569">Blocking / Communication Deadlock / Channel</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"><B>Issue:</B> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">Some description from developers or pervious reseachers &gt; wait.poller() returns a function with type<BR ALIGN="LEFT"/>WaitFunc. &gt; the function creates a goroutine and the goroutine only &gt; quits when after or done closed.<BR ALIGN="LEFT"/>The doneCh defined at line 70 is never closed.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>IPs detected:</B></TD><TD BGCOLOR="#6b7280"><FONT COLOR="white"> no interface pattern detected </FONT></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"><B>What the CFSM shows:</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">• ch0: a receive exists but no goroutine ever sends on it<BR ALIGN="LEFT"/>• ch1: a receive exists but no goroutine ever sends on it<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD> </TD></TR></TABLE>>;
  subgraph cluster_g3 { label=<<B>machine 3: main</B>>; labeljust=l; style="rounded,filled"; fillcolor="#f1f5f9"; color="#94a3b8"; fontsize=12;
    g3_q30 [label="30" penwidth=2.4];
    g3_q31 [label="31"];
    g3_q32 [label="32"];
    g3_q33 [label="33" shape=doublecircle];
    g3_start [shape=point, width=0.08, style=invis, label=""];
    g3_start -> g3_q30 [arrowsize=0.9, color="#475569"];
    g3_q30 -> g3_q31 [label=<ch0 ? struct{}<FONT COLOR="#dc2626">  ⚠ no sender</FONT>>, color="#dc2626", fontcolor="#dc2626", style=solid, penwidth=2.2];
    g3_q31 -> g3_q32 [label=<ch1 ? struct{}<FONT COLOR="#dc2626">  ⚠ no sender</FONT>>, color="#dc2626", fontcolor="#dc2626", style=solid, penwidth=2.2];
    g3_q32 -> g3_q33 [label=<close(ch2)>, color="#b91c1c", fontcolor="#b91c1c", style=dashed, penwidth=1.2];
  }
  legend [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD COLSPAN="5" BGCOLOR="#e2e8f0"><B>Channels in this system</B> (channel relay machines 0–2 omitted from the drawing)</TD></TR><TR><TD><B>name</B></TD><TD><B>allocated in</B></TD><TD><B>sent by</B></TD><TD><B>received by</B></TD><TD><B>closed by</B></TD></TR><TR><TD ALIGN="LEFT">ch0</TD><TD ALIGN="LEFT">main.WaitFor.t0</TD><TD>–</TD><TD>3</TD><TD>–</TD></TR><TR><TD ALIGN="LEFT">ch1</TD><TD ALIGN="LEFT">main.main.t10</TD><TD>–</TD><TD>3</TD><TD>–</TD></TR><TR><TD ALIGN="LEFT">ch2</TD><TD ALIGN="LEFT">main.main.t0</TD><TD>–</TD><TD>–</TD><TD>3</TD></TR><TR><TD COLSPAN="5" ALIGN="LEFT"><FONT POINT-SIZE="10">Edge label  <FONT COLOR="#1d4ed8">ch ! msg</FONT> = send,  <FONT COLOR="#15803d">ch ? msg</FONT> = receive,  <FONT COLOR="#b91c1c">close(ch)</FONT> = STOP message.  Bold circle = start state, double circle = end state, numbers in machines = machine ids.</FONT></TD></TR></TABLE>>];
}