digraph G {
  rankdir=LR; fontname="Helvetica"; compound=true; nodesep=0.35; ranksep=0.55; pad=0.3; bgcolor="white";
  node [fontname="Helvetica", fontsize=11, shape=circle, width=0.42, fixedsize=false, style=filled, fillcolor="#f8fafc", color="#475569"];
  edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
  labelloc=t; labeljust=l;
  label=<<TABLE BORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20"><B>GoBench serving #2137</B></FONT>  <FONT POINT-SIZE="13" COLOR="#475569">Blocking / Mixed Deadlock / Channel &amp; Lock</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"><B>Issue:</B> </FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">Possible intervening<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><B>IPs detected:</B></TD><TD BGCOLOR="#b45309"><FONT COLOR="white"><B> IP-3 </B> Alternative </FONT></TD><TD WIDTH="4"></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"><B>What the CFSM shows:</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">• ch0: a send exists but no goroutine ever receives from it<BR ALIGN="LEFT"/>• ch1: a send exists but no goroutine ever receives from it<BR ALIGN="LEFT"/>• ch2: a send exists but no goroutine ever receives from it<BR ALIGN="LEFT"/>• ch3: a send exists but no goroutine ever receives from it<BR ALIGN="LEFT"/>• ch4: a receive exists but no goroutine ever sends on it<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">Source uses buffered channel(s), capacity 1, queueDepth+maxConcurrency, maxConcurrency; dingo-hunter ignores capacity (models them as unbuffered).</FONT></TD></TR><TR><TD> </TD></TR></TABLE>>;
  subgraph cluster_g5 { label=<<B>machine 5: main</B>>; labeljust=l; style="rounded,filled"; fillcolor="#f1f5f9"; color="#94a3b8"; fontsize=12;
    g5_q50 [label="50" penwidth=2.4];
    g5_q51 [label="51"];
    g5_q52 [label="52" shape=doublecircle];
    g5_start [shape=point, width=0.08, style=invis, label=""];
    g5_start -> g5_q50 [arrowsize=0.9, color="#475569"];
    g5_q50 -> g5_q51 [label=<ch4 ? bool<FONT COLOR="#dc2626">  ⚠ no sender</FONT>>, color="#dc2626", fontcolor="#dc2626", style=solid, penwidth=2.2];
    g5_q51 -> g5_q52 [label=<ch0 ! bool<FONT COLOR="#dc2626">  ⚠ no receiver</FONT>>, color="#dc2626", fontcolor="#dc2626", style=solid, penwidth=2.2];
  }
  subgraph cluster_g6 { label=<<B>machine 6: anonymous goroutine (t12)</B>>; labeljust=l; style="rounded,filled"; fillcolor="#f1f5f9"; color="#94a3b8"; fontsize=12;
    g6_q60 [label="60" penwidth=2.4 fillcolor="#b4530922" color="#b45309" penwidth=2.4 xlabel=<<FONT COLOR="#b45309" POINT-SIZE="10"><B>IP-3</B></FONT>>];
    g6_q61 [label="61"];
    g6_q63 [label="63" shape=doublecircle];
    g6_q62 [label="62" shape=doublecircle];
    g6_start [shape=point, width=0.08, style=invis, label=""];
    g6_start -> g6_q60 [arrowsize=0.9, color="#475569"];
    g6_q60 -> g6_q61 [label=<ch1 ! main.token<FONT COLOR="#dc2626">  ⚠ no receiver</FONT><BR/><FONT COLOR="#b45309" POINT-SIZE="9"><B>[IP-3] </B></FONT>>, color="#dc2626", fontcolor="#dc2626", style=solid, penwidth=2.2];
    g6_q60 -> g6_q63 [label=<ch3 ! bool<FONT COLOR="#dc2626">  ⚠ no receiver</FONT><BR/><FONT COLOR="#b45309" POINT-SIZE="9"><B>[IP-3] </B></FONT>>, color="#dc2626", fontcolor="#dc2626", style=solid, penwidth=2.2];
    g6_q61 -> g6_q62 [label=<ch2 ! main.token<FONT COLOR="#dc2626">  ⚠ no receiver</FONT>>, color="#dc2626", fontcolor="#dc2626", style=solid, penwidth=2.2];
  }
  legend [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#94a3b8"><TR><TD COLSPAN="5" BGCOLOR="#e2e8f0"><B>Channels in this system</B> (channel relay machines 0–4 omitted from the drawing)</TD></TR><TR><TD><B>name</B></TD><TD><B>allocated in</B></TD><TD><B>sent by</B></TD><TD><B>received by</B></TD><TD><B>closed by</B></TD></TR><TR><TD ALIGN="LEFT">ch0</TD><TD ALIGN="LEFT">main.unlock.t8</TD><TD>5</TD><TD>–</TD><TD>–</TD></TR><TR><TD ALIGN="LEFT">ch1</TD><TD ALIGN="LEFT">main.NewBreaker.t3</TD><TD>6</TD><TD>–</TD><TD>–</TD></TR><TR><TD ALIGN="LEFT">ch2</TD><TD ALIGN="LEFT">main.NewBreaker.t5</TD><TD>6</TD><TD>–</TD><TD>–</TD></TR><TR><TD ALIGN="LEFT">ch3</TD><TD ALIGN="LEFT">(*main.Breaker).concurrentRequest.t6</TD><TD>6</TD><TD>–</TD><TD>–</TD></TR><TR><TD ALIGN="LEFT">ch4</TD><TD ALIGN="LEFT">main.unlock.t5</TD><TD>–</TD><TD>5</TD><TD>–</TD></TR><TR><TD COLSPAN="5" ALIGN="LEFT"><FONT POINT-SIZE="10">Edge label  <FONT COLOR="#1d4ed8">ch ! msg</FONT> = send,  <FONT COLOR="#15803d">ch ? msg</FONT> = receive,  <FONT COLOR="#b91c1c">close(ch)</FONT> = STOP message.  Bold circle = start state, double circle = end state, numbers in machines = machine ids.</FONT></TD></TR></TABLE>>];
}