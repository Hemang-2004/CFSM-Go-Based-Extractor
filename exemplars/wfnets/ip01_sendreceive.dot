digraph PetriNet {
  rankdir=LR;
  node [fontname="Arial"];
  label="IP-1 Send/Receive";
  labelloc=t; fontsize=14;

  p0 [shape=doublecircle, style=filled, fillcolor="#90EE90", label="start (1)"];
  p1 [shape=circle, style=filled, fillcolor="#ADD8E6", label="main_ready"];
  p2 [shape=circle, style=filled, fillcolor="#ADD8E6", label="goroutine_running"];
  p3 [shape=circle, style=filled, fillcolor="#ADD8E6", label="channel_buffer"];
  p4 [shape=circle, style=filled, fillcolor="#ADD8E6", label="go_done"];
  p5 [shape=circle, style=filled, fillcolor="#ADD8E6", label="recv_done"];
  p6 [shape=doublecircle, style=filled, fillcolor="#ADD8E6", label="end"];

  t0 [shape=box, style=filled, fillcolor="#FFD700", label="spawn goroutine"];
  t1 [shape=box, style=filled, fillcolor="#FFD700", label="send on channel"];
  t2 [shape=box, style=filled, fillcolor="#FFD700", label="receive from channel"];
  t3 [shape=box, style=filled, fillcolor="#FFD700", label="finish"];

  p0 -> t0;
  t0 -> p1;
  t0 -> p2;
  p2 -> t1;
  t1 -> p3;
  t1 -> p4;
  p1 -> t2;
  p3 -> t2;
  t2 -> p5;
  p5 -> t3;
  p4 -> t3;
  t3 -> p6;
}