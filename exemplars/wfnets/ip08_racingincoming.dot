digraph PetriNet {
  rankdir=LR;
  node [fontname="Arial"];
  label="IP-8 Racing incoming";
  labelloc=t; fontsize=14;

  p0 [shape=doublecircle, style=filled, fillcolor="#90EE90", label="start (1)"];
  p1 [shape=circle, style=filled, fillcolor="#ADD8E6", label="main_ready"];
  p2 [shape=circle, style=filled, fillcolor="#ADD8E6", label="goroutine_running"];
  p6 [shape=circle, style=filled, fillcolor="#ADD8E6", label="after_select"];
  p4 [shape=doublecircle, style=filled, fillcolor="#ADD8E6", label="end"];

  t0 [shape=box, style=filled, fillcolor="#FFD700", label="spawn goroutine"];
  t1 [shape=box, style=filled, fillcolor="#FFD700", label="select choice"];
  t2 [shape=box, style=filled, fillcolor="#FFD700", label="finish"];

  p0 -> t0;
  t0 -> p1;
  t0 -> p2;
  p1 -> t1;
  t1 -> p6;
  p3 -> t2;
  t2 -> p4;
}